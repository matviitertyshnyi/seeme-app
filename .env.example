# SeeMe Cloud Database Configuration (Upstash Redis)
# Option 1: In Vercel Dashboard -> Storage -> Create Database -> Upstash Redis (auto-injected)
# Option 2: Go to console.upstash.com, create a free database, and paste your REST credentials below:

UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Also compatible with Vercel KV aliases:
# KV_REST_API_URL=https://your-db-name.upstash.io
# KV_REST_API_TOKEN=your_token_here
